# Nothing here is built or installed — the repo IS the site. These are
# leftovers from the old Sprechen mode and from local tooling.

# whisper.cpp binaries, model weights and the LanguageTool jar: hundreds of MB
whisper/
languagetool/

__pycache__/
*.pyc

# intermediates from make-audio.py; the mp3s beside them are committed
# audio/**/*.wav
audio/_demo/

# Piper voice models, downloaded on demand by make-audio.py
voices/

api-key.txt
.env
node_modules/

.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# The Remotion project builds the Gespräch films. What ships is video/*.mp4 and
# the poster beside it, both committed; everything below is an intermediate.
remotion/out/
# copies of audio/, made by build-data.mjs so staticFile() can reach them
remotion/public/*
# ...except the 3D models the acted films load: those are source, not copies
!remotion/public/models/
